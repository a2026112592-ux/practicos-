#include <iostream>
#include <cmath>
using namespace std;

int main() {
    double x, suma = 0;
    int n;
    cout << "Ingrese el valor de X: ";
    cin >> x;
    cout << "Ingrese N: ";
    cin >> n;
    for (int i = 1; i <= n; i++) {
        suma += pow(x, i);
    }
    cout << "El resultado de la serie es: " << suma << endl;
    return 0;
}
