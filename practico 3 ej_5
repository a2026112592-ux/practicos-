#include <iostream>
#include <cmath>

using namespace std;

int main() {
    double C, T;
    int N;

    cout << "Ingrese el capital prestado (C): ";
    cin >> C;
    cout << "Ingrese la tasa de interes mensual en decimal (ej. 0.02 para 2%): ";
    cin >> T;
    cout << "Ingrese el numero de cuotas (N): ";
    cin >> N;

    double cuotaMensual = C * (T * pow(1 + T, N)) / (pow(1 + T, N) - 1);[cite: 1]
    double montoTotal = cuotaMensual * N;

    cout << "Cuota mensual a pagar: " << cuotaMensual << endl;
    cout << "Monto total a pagar por el credito: " << montoTotal << endl;

    return 0;
}
