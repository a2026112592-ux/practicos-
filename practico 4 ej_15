#include <iostream>
#include <thread>
#include <chrono>
#include <iomanip>
using namespace std;

int main() {
    for (int h = 0; h < 24; h++) {
        for (int m = 0; m < 60; m++) {
            for (int s = 0; s < 60; s++) {
                cout << "\033[2J\033[1;1H";
                cout << setfill('0') << setw(2) << h << ":"
                     << setfill('0') << setw(2) << m << ":"
                     << setfill('0') << setw(2) << s << endl;
                this_thread::sleep_for(chrono::seconds(1));
            }
        }
    }
    return 0;
}
