#include <iostream>
#include <cmath>
using namespace std;

long long FAC(int n) {
    long long fact = 1;
    for (int i = 1; i <= n; i++) fact *= i;
    return fact;
}

double POTEN(double x, double y) {
    return pow(x, y);
}

double calcularSerie(int x, int n) {
    double suma = 0.0;
    for (int i = 1; i <= n; i++) {
        suma += POTEN(x, i) / FAC(i);
    }
    return suma;
}

int main() {
    int x, n;
    cout << "Ingrese X (entero positivo): ";
    cin >> x;
    cout << "Ingrese N (entero positivo): ";
    cin >> n;

    if (x > 0 && n > 0) {
        cout << "La suma de la serie S es: " << calcularSerie(x, n) << endl;
    } else {
        cout << "X y N deben ser enteros positivos." << endl;
    }
    return 0;
}
