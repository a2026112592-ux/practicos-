// Ejercicio 7: Genera código de 3 letras usando length() y substr()
string generarCodigo(string nombre) {
    if (nombre.length() >= 3) {
        return nombre.substr(0, 3);
    }
    return nombre;
}

// Ejercicio 7: Muestra productos con stock menor a 5 y cuenta alertas
void mostrarStockBajo(const string productos[], const string marcas[], const int cantidades[], int total) {
    if (total == 0) {
        cout << "El inventario esta vacio.\n";
        return;
    }

    int alertas = 0;
    cout << "\n--- ALERTAS DE STOCK BAJO (< 5 unidades) ---\n";
    for (int i = 0; i < total; i++) {
        if (cantidades[i] < 5) {
            string codigo = generarCodigo(productos[i]);
            cout << "ALERTA [" << i << "] Codigo: " << codigo
                 << " | Producto: " << productos[i]
                 << " | Marca: " << marcas[i]
                 << " | Stock: " << cantidades[i] << "\n";
            alertas++;
        }
    }

    cout << "Total de productos con stock bajo: " << alertas << "\n";
}
