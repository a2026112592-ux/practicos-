    cout << "7. Alertas de stock bajo y codigos (Ej. 7)\n";
    cout << "8. Consultar productos por marca (Ej. 8)\n";
    cout << "9. Corregir o editar nombres (Ej. 9)\n";
    cout << "10. Mostrar resumen del inventario (Ej. 10)\n";
    cout << "0. Salir\n";
    cout << "Seleccione una opcion: ";

    while (!(cin >> op)) {
        cin.clear();
