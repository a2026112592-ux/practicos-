    return op;
}

// Ejercicio 1: Solicita y valida datos de un producto por referencia (empty, length)
bool registrarProducto(string &nombre, string &marca, int &cantidad) {
    cout << "Nombre del producto (min. 3 caracteres): ";
    getline(cin, nombre);
    if (nombre.empty() || nombre.length() < 3) {
        cout << "Error: El nombre no puede estar vacio y debe tener al menos 3 caracteres.\n";
        return false;
    }

    cout << "Marca del producto (min. 3 caracteres): ";
    getline(cin, marca);
    if (marca.empty() || marca.length() < 3) {
        cout << "Error: La marca no puede estar vacia y debe tener al menos 3 caracteres.\n";
        return false;
    }

    cout << "Cantidad disponible (>= 0): ";
    if (!(cin >> cantidad)) {
        cin.clear();
        cin.ignore(10000, '\n');
        cout << "Error: Debe ingresar un numero entero.\n";
        return false;
    }
    cin.ignore(10000, '\n');

    if (cantidad < 0) {
        cout << "Error: La cantidad no puede ser negativa.\n";
        return false;
    }

    return true;
}

// Ejercicio 1: Muestra la información de un único producto
void mostrarProducto(string nombre, string marca, int cantidad) {
    cout << "  Producto: " << nombre << " | Marca: " << marca << " | Stock: " << cantidad << "\n";
}
