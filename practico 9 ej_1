#include <iostream>
#include <string>

using namespace std;

const int MAX = 20;

// --- PROTOTIPOS DE FUNCIONES ---
int mostrarMenu();
bool registrarProducto(string &nombre, string &marca, int &cantidad);
void mostrarProducto(string nombre, string marca, int cantidad);
void registrarProductos(string productos[], string marcas[], int cantidades[], int &total);
void mostrarProductos(const string productos[], const string marcas[], const int cantidades[], int total);
void buscarProductos(const string productos[], const string marcas[], const int cantidades[], int total);
int buscarExacto(const string productos[], const string marcas[], int total, string nombreBuscado, string marcaBuscada);
void actualizarStock(string productos[], string marcas[], int cantidades[], int total);
void registrarVenta(string productos[], string marcas[], int cantidades[], int total);
void reponerStock(string productos[], string marcas[], int cantidades[], int total);
string generarCodigo(string nombre);
void mostrarStockBajo(const string productos[], const string marcas[], const int cantidades[], int total);
void buscarPorMarca(const string productos[], const string marcas[], const int cantidades[], int total);
void menuEdicionNombres(string productos[], string marcas[], int total);
void corregirNombre(string productos[], string marcas[], int total);
void agregarPrefijo(string productos[], string marcas[], int total);
void quitarPrefijo(string productos[], string marcas[], int total);
void mostrarResumen(const string productos[], const string marcas[], const int cantidades[], int total);

// --- FUNCIÓN PRINCIPAL ---
int main() {
    string productos[MAX];
    string marcas[MAX];
    int cantidades[MAX];
    int total = 0;
    int opcion;

    do {
        opcion = mostrarMenu();

        switch (opcion) {
            case 1:
                registrarProductos(productos, marcas, cantidades, total);
                break;
            case 2:
                mostrarProductos(productos, marcas, cantidades, total);
                break;
            case 3:
                buscarProductos(productos, marcas, cantidades, total);
                break;
            case 4:
                actualizarStock(productos, marcas, cantidades, total);
                break;
            case 5:
                registrarVenta(productos, marcas, cantidades, total);
                break;
            case 6:
                reponerStock(productos, marcas, cantidades, total);
                break;
            case 7:
                mostrarStockBajo(productos, marcas, cantidades, total);
                break;
            case 8:
                buscarPorMarca(productos, marcas, cantidades, total);
                break;
            case 9:
                menuEdicionNombres(productos, marcas, total);
                break;
            case 10:
                mostrarResumen(productos, marcas, cantidades, total);
                break;
            case 0:
                cout << "Saliendo del sistema de inventario...\n";
                break;
            default:
                cout << "Opcion no valida. Intente nuevamente.\n";
        }
    } while (opcion != 0);

    return 0;
}

// --- DEFINICIÓN DE FUNCIONES ---

