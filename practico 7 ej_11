#include <iostream>
#include <string>
#include <cmath>
#include <cstdio>
using namespace std;

string unidades[] = {"", "un", "dos", "tres", "cuatro", "cinco", "seis", "siete", "ocho", "nueve"};
string especiales[] = {"diez", "once", "doce", "trece", "catorce", "quince", "dieciseis", "diecisiete", "dieciocho", "diecinueve"};
string decenas[] = {"", "", "veinte", "treinta", "cuarenta", "cincuenta", "sesenta", "setenta", "ochenta", "noventa"};
string centenas[] = {"", "ciento", "doscientos", "trescientos", "cuatrocientos", "quinientos", "seiscientos", "setecientos", "ochocientos", "novecientos"};

string convertirTresCifras(int n) {
    if (n == 100) return "cien";
    string res = "";
    int c = n / 100;
    int d = (n % 100) / 10;
    int u = n % 10;

    if (c > 0) res += centenas[c] + " ";

    if (d == 1) {
        res += especiales[u] + " ";
    } else {
        if (d > 0) {
            res += decenas[d];
            if (u > 0) res += " y " + unidades[u];
            res += " ";
        } else if (u > 0) {
            res += unidades[u] + " ";
        }
    }
    return res;
}

string convertirMontoALiteral(double r) {
    int entero = (int)r;
    int centavos = round((r - entero) * 100);
    int miles = entero / 1000;
    int resto = entero % 1000;
    string texto = "";

    if (miles > 0) {
        if (miles == 1) texto += "un mil ";
        else texto += convertirTresCifras(miles) + "mil ";
    }

    if (resto > 0) {
        texto += convertirTresCifras(resto);
    }

    if (entero == 0) texto = "cero ";

    char centStr[30];
    sprintf(centStr, "%02d/100 bolivianos", centavos);
    return texto + string(centStr);
}

int main() {
    double r = 1560.50;
    cout << "Bs " << r << " -> " << convertirMontoALiteral(r) << endl;
    return 0;
}
