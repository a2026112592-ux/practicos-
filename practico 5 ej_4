#include <iostream>
using namespace std;

int main() {
    int n, original, invertido = 0;
    cin >> n;
    original = n;
    while (n > 0) {
        invertido = invertido * 10 + n % 10;
        n /= 10;
    }
    if (original == invertido) {
        cout << "Es capicúa" << endl;
    } else {
        cout << "No es capicúa" << endl;
    }
    return 0;
}
