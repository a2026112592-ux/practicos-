#include <iostream>
#include <cmath>
using namespace std;

int main() {
    double x, suma = 0;
    int n;
    cout << "Ingrese el valor de X: ";
    cin >> x;
    cout << "Ingrese N (debe ser impar): ";
    cin >> n;
    long long fact = 1;
    int signo = 1;
    for (int i = 1; i <= n; i++) {
        fact *= i;
        if (i % 2 != 0) {
            suma += signo * (pow(x, i) / fact);
            signo *= -1;
        }
    }
    cout << "El resultado de la serie es: " << suma << endl;
    return 0;
}
