#include <iostream>
using namespace std;

int main() {
    int N, divisores = 0;
    cout << "Ingrese N: ";
    cin >> N;
    if (N <= 1) {
        cout << N << " no es un numero primo." << endl;
        return 0;
    }
    for (int i = 1; i <= N; i++) {
        if (N % i == 0) {
            divisores++;
        }
    }
    if (divisores == 2) {
        cout << N << " es un numero primo." << endl;
    } else {
        cout << N << " no es un numero primo." << endl;
    }
    return 0;
}
