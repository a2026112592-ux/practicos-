#include <iostream>
#include <cmath>
using namespace std;

double redondear(double R, int n) {
    double factor = pow(10.0, n);
    return round(R * factor) / factor;
}

int main() {
    double R;
    int n;
    cout << "Ingrese el número real R: ";
    cin >> R;
    cout << "Ingrese la cantidad de decimales n: ";
    cin >> n;

    cout << "Resultado redondeado: " << redondear(R, n) << endl;
    return 0;
}
