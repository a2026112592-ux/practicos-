#include <iostream>
#include <string>
using namespace std;

string obtenerEstacion(int dia, int mes) {
    if ((mes == 3 && dia >= 21) || mes == 4 || mes == 5 || (mes == 6 && dia < 21)) {
        return "otono";
    } else if ((mes == 6 && dia >= 21) || mes == 7 || mes == 8 || (mes == 9 && dia < 21)) {
        return "invierno";
    } else if ((mes == 9 && dia >= 21) || mes == 10 || mes == 11 || (mes == 12 && dia < 21)) {
        return "primavera";
    } else {
        return "verano";
    }
}

int main() {
    int dia, mes, anio;
    cout << "Ingrese dia, mes y anio: ";
    cin >> dia >> mes >> anio;

    if (dia >= 1 && dia <= 31 && mes >= 1 && mes <= 12) {
        cout << "Estacion: " << obtenerEstacion(dia, mes) << endl;
    } else {
        cout << "Fecha invalida." << endl;
    }
    return 0;
}
