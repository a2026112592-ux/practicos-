#include <iostream>

using namespace std;

int main() {
    double l1, l2, l3;

    cout << "Ingrese la longitud del primer lado: ";
    cin >> l1;
    cout << "Ingrese la longitud del segundo lado: ";
    cin >> l2;
    cout << "Ingrese la longitud del tercer lado: ";
    cin >> l3;

    // Verificar si forman un triangulo valido
    if (l1 + l2 > l3 && l1 + l3 > l2 && l2 + l3 > l1) {
        if (l1 == l2 && l2 == l3) {
            cout << "El triangulo es EQUILATERO." << endl;
        } else if (l1 == l2 || l1 == l3 || l2 == l3) {
            cout << "El triangulo es ISOSCELES." << endl;
        } else {
            cout << "El triangulo es ESCALENO." << endl;
        }
    } else {
        cout << "Los lados ingresados no forman un triangulo valido." << endl;
    }

    return 0;
}
