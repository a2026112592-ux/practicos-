    cin >> salario;
    cout << "Ingrese los meses trabajados en el ano (1-12): ";
    cin >> meses;

    double aguinaldo = (salario * meses) / 12.0;[cite: 1]

    cout << "\nEmpleado: " << nombre << endl;
