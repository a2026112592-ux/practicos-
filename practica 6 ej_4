#include <iostream>
using namespace std;

int convertirASegundos(int h, int m, int s) {
    return h * 3600 + m * 60 + s;
}

void mostrarDiferencia(int segInicio, int segFin) {
    int diff = segFin - segInicio;
    int h = diff / 3600;
    int m = (diff % 3600) / 60;
    int s = diff % 60;

    cout << "Tiempo transcurrido: " << h << ":" << m << ":" << s << endl;
}

int main() {
    int h1, m1, s1, h2, m2, s2;
    cout << "Ingrese primer horario (hh mm ss): ";
    cin >> h1 >> m1 >> s1;
    cout << "Ingrese segundo horario (hh mm ss): ";
    cin >> h2 >> m2 >> s2;

    int seg1 = convertirASegundos(h1, m1, s1);
    int seg2 = convertirASegundos(h2, m2, s2);

    if (seg2 >= seg1) {
        mostrarDiferencia(seg1, seg2);
    } else {
        cout << "El primer horario debe estar antes que el segundo." << endl;
    }
    return 0;
}
