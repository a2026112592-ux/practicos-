#include <iostream>
#include <cmath>
using namespace std;

bool esBisiesto(int a) {
    return (a % 4 == 0 && a % 100 != 0) || (a % 400 == 0);
}

// Convierte fecha a días absolutos acumulados
long long fechaADias(int d, int m, int a) {
    int diasMes[] = {0, 31, 28, 31, 30, 31, 30, 31, 31, 30, 31, 30, 31};
    long long total = d;

    for (int i = 1; i < a; i++) {
        total += esBisiesto(i) ? 366 : 365;
    }
    for (int i = 1; i < m; i++) {
        if (i == 2 && esBisiesto(a)) total += 29;
        else total += diasMes[i];
    }
    return total;
}

void diasTranscurridos(int d1, int m1, int a1, int d2, int m2, int a2) {
    long long total1 = fechaADias(d1, m1, a1);
    long long total2 = fechaADias(d2, m2, a2);
    cout << "Días transcurridos: " << abs(total2 - total1) << " días." << endl;
}

int main() {
    int d1, m1, a1, d2, m2, a2;
    cout << "Ingrese primera fecha (día mes año): ";
    cin >> d1 >> m1 >> a1;
    cout << "Ingrese segunda fecha (día mes año): ";
    cin >> d2 >> m2 >> a2;

    diasTranscurridos(d1, m1, a1, d2, m2, a2);
    return 0;
}
