#include <iostream>
#include <cmath>
using namespace std;

long long FAC(int n) {
    long long fact = 1;
    for (int i = 1; i <= n; i++) fact *= i;
    return fact;
}

double POTEN(double x, double y) {
    return pow(x, y);
}

double calcularSerieAlternada(int x, int n) {
    double suma = 0.0;
    int signo = 1;
    for (int i = 1; i <= n; i++) {
        int exp = 2 * i - 1; // Términos impares: 1, 3, 5, 7...
        double termino = POTEN(x, exp) / FAC(exp);
        suma += signo * termino;
        signo = -signo; // Alterna el signo
    }
    return suma;
}

int main() {
    int x, n;
    cout << "Ingrese X: ";
    cin >> x;
    cout << "Ingrese cantidad de términos N: ";
    cin >> n;

    cout << "La suma de la serie alternada es: " << calcularSerieAlternada(x, n) << endl;
    return 0;
}
