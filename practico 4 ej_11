#include <iostream>
using namespace std;

int main() {
    int a, b;
    cout << "Ingrese el primer número: ";
    cin >> a;
    cout << "Ingrese el segundo número: ";
    cin >> b;
    int temp_a = a, temp_b = b;
    while (temp_b != 0) {
        int residuo = temp_a % temp_b;
        temp_a = temp_b;
        temp_b = residuo;
    }
    cout << "El MCD de " << a << " y " << b << " es: " << temp_a << endl;
    return 0;
}
