#include <iostream>
using namespace std;

long long FAC(int n) {
    if (n < 0) return 0;
    long long fact = 1;
    for (int i = 1; i <= n; i++) fact *= i;
    return fact;
}

long long Combi(int n, int r) {
    if (r < 0 || r > n) return 0;
    return FAC(n) / (FAC(r) * FAC(n - r));
}

int main() {
    int n, r;
    cout << "Ingrese n: ";
    cin >> n;
    cout << "Ingrese r: ";
    cin >> r;

    long long C = Combi(n, r);
    cout << "Combi(" << n << ", " << r << ") = " << C << endl;
    return 0;
}
